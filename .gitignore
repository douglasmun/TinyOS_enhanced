# ============================================================================
# TinyOS Enhanced — .gitignore
# ============================================================================

# --- Build artifacts ---
*.o
*.a
*.elf
*.bin
*.iso
*.d
bin/
dist/
build/
# built kernel copied into the ISO tree:
iso/boot/kernel.elf

# --- Disk images ---
*.img
*.qcow2

# --- Keys / secrets — NEVER commit private key material ---
# (src/trusted_signing_key.h is the PUBLIC verification key and IS tracked.)
*.pem
*.key
id_rsa
id_ed25519
hardcoded_rsa_keys.h
host_rsa_key_details.txt
host_rsa_key.pem
keys/

# --- Runtime / debug capture artifacts ---
serial.log
serial_*.log
panic.log
qemu.log
*.pcap
network_trace.txt
log/
firstexec-trials.log
# Harness serial + QEMU trace captures. Named per harness, so enumerate rather
# than blanket-ignoring *.log (doc/ and web/ may legitimately carry one).
idsblock*.log
fwdeny*.log
udprx*.log
dhcprx*.log
icmpovr*.log
dfault-serial.log
dfault-trace.log
# Spliced copies a harness writes beside its serial log to repair EDR-torn
# lines. Purely derived, so a blanket pattern is safe here.
*.rejoined

# --- Personal ops scripts (not part of the OS; reference a specific GitHub repo) ---
publish.sh

# --- Vendored / generated, not project source ---
lib/
pyvenv.cfg
__pycache__/
*.pyc
screenshots/
*.mov
*.tar.gz

# --- Ad-hoc developer test scripts / host-side reference programs ---
# Not part of the published product (the canonical harness is verify-exec.sh at
# the repo root). Kept on disk locally; not tracked or published.
test/

# --- SSH/SSHD/RSA removed from the build (kept on disk, not compiled) ---
src/ssh.c
src/ssh.h
src/ssh_crypto.c
src/ssh_crypto.h
src/rsa.c
src/rsa.h
src/ssh.c.backup
src/ssh.c.bak
src/ssh_clean.txt

# --- TLS 1.3 HKDF/AES-GCM/ECDHE demo surface removed from the build ---
# (kept on disk for future reference, not compiled or linked). Their only
# caller was src/tls13_demo.c, itself never built; see the Makefile NOTE.
src/hkdf.c
src/hkdf.h
src/aes_gcm.c
src/aes_gcm.h
src/ecdhe.c
src/ecdhe.h
src/tls13_demo.c

# --- OS / editor cruft ---
.DS_Store
.playwright-mcp/

# --- Historical / superseded docs cut from the public set (kept on disk, not published) ---
# They live together in doc/archive/, one directory rather than one line per
# file. Historical docs that were once public are folded into
# doc/SECURITY_STATUS_COMPLETE.md ("Folded historical documents") and removed;
# git history keeps their text. The rest of this block is local-only too.
# publish.sh exports `git archive HEAD` (tracked files only), so these never
# reach GitHub regardless; these patterns just keep them out of the index.
firstexec-trial.sh
doc/archive/
bgjobs.log
bgjobs-trace.log
netdb.log
netdb-trace.log
tcpserverpath.log
tcpserverpath-trace.log
redirect.log
redirect-trace.log
ring3-redirect.log
ring3-redirect-trace.log
ring3-pipes.log
ring3-pipes-trace.log
ring3date.log
ring3date-trace.log
ring3chmod.log
ring3chmod-trace.log
ring3env.log
ring3env-trace.log
ring3builtins.log
ring3builtins-trace.log
envpertask.log
envpertask-trace.log
scratchpad/
argv.log
argv-trace.log
spawn.log
spawn-trace.log
pipes.log
pipes-trace.log
pipes-exec.log
